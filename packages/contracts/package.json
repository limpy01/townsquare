{
  "name": "@townsquare/contracts",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./legacy-envelope": {
      "types": "./dist/legacy-envelope.d.ts",
      "require": "./dist/legacy-envelope.js",
      "default": "./dist/legacy-envelope.js"
    },
    "./custom-script": {
      "types": "./dist/custom-script.d.ts",
      "require": "./dist/custom-script.js",
      "default": "./dist/custom-script.js"
    },
    "./game-state": {
      "types": "./dist/game-state.d.ts",
      "require": "./dist/game-state.js",
      "default": "./dist/game-state.js"
    },
    "./dynamic-init": {
      "types": "./dist/dynamic-init.d.ts",
      "require": "./dist/dynamic-init.js",
      "default": "./dist/dynamic-init.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
